# SiteDAO Contract Addresses
# Bu dosya deploy.ts scripti tarafından otomatik oluşturulur
# Manuel olarak da düzenleyebilirsiniz

NEXT_PUBLIC_PACKAGE_ID=
NEXT_PUBLIC_TREASURY_ID=
NEXT_PUBLIC_RENTAL_REGISTRY_ID=
NEXT_PUBLIC_PROPOSAL_REGISTRY_ID=

# governance::init tarafından deploy edene gönderilen GovernanceAdminCap nesnesinin ID'si.
# Teklif oluşturma işlemi bu olmadan zincire yazılamaz (uygulama demo moduna düşer).
NEXT_PUBLIC_GOVERNANCE_ADMIN_CAP_ID=

# Apartment için paylaşılan TransferPolicy nesnesinin ID'si.
# Deploy sonrası apartment::create_transfer_policy bir kez çağrılarak oluşturulur.
# Kiraya çıkarma işlemi daireyi Kiosk'a kilitlediği için bu olmadan çalışmaz.
NEXT_PUBLIC_APARTMENT_POLICY_ID=

# mainnet | testnet | devnet | localnet
NEXT_PUBLIC_NETWORK=testnet

# RPC uç noktası (isteğe bağlı)
# Sui'nin genel fullnode'ları JSON-RPC'yi kaldırdı ve tarayıcıdan CORS'a izin vermiyor.
# Zincirden okuma yapabilmek için JSON-RPC sunan bir uç nokta verin, örn:
#   https://sui-testnet-rpc.publicnode.com
NEXT_PUBLIC_SUI_RPC_URL=

# Yönetici e-postaları - virgülle ayrılmış
# Örn: yonetici@ornek.com,ikinci.yonetici@ornek.com
NEXT_PUBLIC_ADMIN_EMAILS=

# IPFS Configuration (Pinata veya başka bir provider)
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ============================================
# zkLogin Configuration (Google OAuth)
# ============================================

# Google OAuth Client ID
# Google Cloud Console'dan alın: https://console.cloud.google.com/apis/credentials
# 1. "Create Credentials" -> "OAuth client ID" seçin
# 2. Application type: "Web application"
# 3. Authorized JavaScript origins: http://localhost:3010
# 4. Authorized redirect URIs: http://localhost:3010/api/auth/callback/google
#
# Not: Uygulama 3010 portunda çalışır (package.json). Farklı bir portta
# çalıştırırsanız yukarıdaki adresleri de o porta göre kaydedin, yoksa Google
# redirect_uri_mismatch döndürür.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# zkLogin Prover URL (varsayılan: Mysten dev prover)
NEXT_PUBLIC_PROVER_URL=https://prover-dev.mystenlabs.com/v1

# zkLogin salt servisi sırrı (SUNUCU TARAFI - asla istemciye gönderilmez)
#
# Salt, kullanıcının Google kimliği ile Sui adresi arasındaki bağı gizler.
# İstemcide hesaplanamaz; /api/zklogin/salt bu sır ile deterministik olarak üretir.
# Rastgele ve uzun bir değer üretin, örn:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# UYARI: Bu değer değişirse tüm kullanıcıların Sui adresi değişir.
ZKLOGIN_SALT_SECRET=
